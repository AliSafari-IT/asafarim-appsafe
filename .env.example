# Express API
APP_ACCESS_CODE=replace-with-a-long-owner-only-code
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
PORT=4000
SESSION_TTL_SECONDS=28800
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false

# Next.js server-side rewrite target
API_URL=http://localhost:4000

# Optional: public demo linked from the gate (defaults to the GitHub Pages demo)
NEXT_PUBLIC_DEMO_URL=https://alisafari-it.github.io/asafarim-appsafe/
