{
  "name": "@asafarim/appsafe-cli",
  "version": "0.4.0",
  "description": "Config-driven local file and folder encryption CLI for AppSafe",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "appsafe": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:test": "tsc --noEmit -p test/tsconfig.json",
    "cli": "tsx src/cli.ts",
    "pretest": "pnpm --filter @asafarim/appsafe build",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@asafarim/appsafe": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
